# Cadena de conexión a Postgres (Supabase)
DATABASE_URL=

# Salt usado para hashear la IP (sha256) antes de guardarla en analytics_events
HASH_SALT=

# Credenciales de Basic Auth para /dashboard, /api/metrics y /api/spend
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Número de WhatsApp de destino, formato internacional sin signos (ej. 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=
